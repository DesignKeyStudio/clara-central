# ============================================================
# Clara Central — Environment Variables
# Copy this file to .env.local and prisma/.env, then fill in
# your Supabase project values.
# ============================================================

# ── Database (Supabase PostgreSQL via Prisma) ──

# Shared connection pooler — port 6543, used for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — port 5432, used for migrations only
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Supabase Auth ──

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Demo cleanup cron auth. Vercel Cron sends this as `Authorization: Bearer <secret>`
# to /api/cron/cleanup-demo (daily). Set the same value in the Vercel project env.
CRON_SECRET="a-long-random-string"

# Partner login OTP delivery.
# Default (unset/false): NO email is sent — partner login accepts any 6-digit
# code and mints the session server-side for the matching approved partner. Use
# this until a sending domain + SMTP are configured (the current deployed variant).
# Set to "true" to require a REAL emailed 6-digit code (signInWithOtp / verifyOtp);
# then the Supabase project must be configured in the dashboard:
#   1. Auth → Email Templates → "Magic Link": include the {{ .Token }} variable
#      so the email contains the 6-digit code (not just a magic link).
#   2. Auth → Providers → Email: a working sender (Supabase's built-in SMTP for
#      low volume, or a custom SMTP / Resend for production deliverability).
# Supabase enforces its own OTP send rate limits per project (Auth → Rate Limits).
# NEXT_PUBLIC_PARTNER_OTP_EMAIL="true"

# ── Email (Resend) ──

# Transactional email (partner invitations + approval notices) via Resend.
# Without RESEND_API_KEY set, those sends are skipped (the app still works; the
# invite dialog falls back to "share this link").
RESEND_API_KEY="re_..."

# Sender address. Until a domain is verified in Resend, the test sender
# "onboarding@resend.dev" only delivers to YOUR Resend account email. Swap to a
# verified-domain address (e.g. "Clara Central <no-reply@yourdomain.com>") in
# production — no code change needed.
EMAIL_FROM="Clara Central <onboarding@resend.dev>"

# ── App URL ──

# Base origin used to build invite + partner-login links. If unset, it's derived
# from the request headers. Set this to your deployed URL in production so links
# in emails point to the right place. It also supplies the transactional-email
# footer link — when unset, that footer shows the copyright line with no link.
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# ── Branding ──

# Product name shown in the transactional-email header band and footer. Change
# this if you fork — do not send mail branded as someone else's product.
# NEXT_PUBLIC_BRAND_NAME="Your Product"

# ── Optional ──

# SUPABASE_ACCESS_TOKEN=""     # CLI management token
# SUPABASE_PROJECT_REF=""      # Used by supabase CLI

# ── Prototype mode ──
# Set to "true" to activate the auth mock + ephemeral SQLite at prisma/prototype.db.
# DB is wiped on every `pnpm dev` start; demo user "demo@prototype.local" is
# always logged in. See src/lib/supabase/mock-client.ts for the mock auth wiring.
# When enabled, DATABASE_URL should be "file:./prisma/prototype.db".
# NEXT_PUBLIC_PROTOTYPE_MODE="true"
